# 画意接龙后端配置示例
# 复制为 .env 并填入真实值。真实密钥只能写入 .env，禁止写入 docs/.sdd/报告/经验。

# 服务
HOST=127.0.0.1
PORT=8099
DEBUG=true

# CORS（同时允许 Agent 验证 5199 和用户门禁 5175）
CORS_ORIGINS=["http://localhost:5199","http://127.0.0.1:5199","http://localhost:5175","http://127.0.0.1:5175"]

# 数据库（项目根相对路径，运行时解析为绝对路径）
DATABASE_PATH=backend/data/draw_telephone.db

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# AI/LLM 文本生成（公司内网 MaaS / 海康）—— 起手题词生成（T-015）
# MaaS 兼容 OpenAI /chat/completions 格式，DeepSeek 模型做文本生成
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://maas.hikvision.com.cn/v1
DEEPSEEK_MODEL=DeepSeek-V4-Flash-0731

# 图像生成（公司内网 MaaS / 海康 Qwen-Image）—— 文生图，AI 补位画节点（T-024）
IMAGE_API_KEY=
IMAGE_BASE_URL=https://maas.hikvision.com.cn/v1
IMAGE_MODEL=Qwen-Image

# 多模态看图（公司内网 MaaS / 海康）—— 看图生成文字，AI 补位述节点（T-024）
VLM_API_KEY=
VLM_BASE_URL=https://maas.hikvision.com.cn/v1
VLM_MODEL=Qwen3.6-35B-A3B-FP8

# AI 补位定时任务
AI_FILL_TIMEOUT_HOURS=24
CHAIN_EXPIRE_DAYS=7
